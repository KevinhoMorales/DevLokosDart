rules_version = '2';

// Reglas de seguridad Firestore — Fase 2
// Escrituras de contenido solo vía Firebase Admin SDK (CMS Web).
// Clients (app/web públicos) solo leen (salvo perfil de usuario propio).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // accountRole: user | member | admin. Solo create como 'user'; el cliente no puede elevarlo.
    function accountRoleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountRole']);
    }

    function validUserCreate() {
      return request.resource.data.accountRole == 'user';
    }

    match /dev_users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId) && accountRoleUnchanged();
      allow delete: if isOwner(userId);
    }

    // Usuarios anidados prod/prod/users y dev/dev/users
    match /dev/dev/users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId) && accountRoleUnchanged();
      allow delete: if isOwner(userId);
    }
    match /prod/prod/users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId) && accountRoleUnchanged();
      allow delete: if isOwner(userId);
    }

    // Legacy path (si aún se usa)
    match /prod/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId) && accountRoleUnchanged();
      allow delete: if isOwner(userId);
    }

    // Lista de admins CMS: solo lectura autenticada; altas desde Firebase Console
    match /dev/dev/admin/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /prod/prod/admin/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cursos — lectura pública; escritura solo Admin SDK
    match /dev/dev/courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }
    match /prod/prod/courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // Eventos — lectura pública; escritura solo Admin SDK
    match /dev/dev/events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /prod/prod/events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Empresarial (raíz)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }
    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    // Productos (raíz — catálogo de venta)
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all lectura auth para colecciones legacy con prefijo dev_/prod_
    match /{collection}/{document=**} {
      allow read: if request.auth != null
        && (collection.matches('dev_.*') || collection.matches('prod_.*'));
      allow write: if false;
    }
  }
}
