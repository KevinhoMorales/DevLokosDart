rules_version = '2';

// Reglas de seguridad Firestore — Fase 2
// Escrituras de contenido solo vía Firebase Admin SDK (CMS Web).
// Clients (app/web públicos) solo leen.
service cloud.firestore {
  match /databases/{database}/documents {

    match /dev_users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Usuarios anidados prod/prod/users y dev/dev/users
    match /dev/dev/users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /prod/prod/users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy path (si aún se usa)
    match /prod/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Lista de admins: solo lectura autenticada; altas desde Firebase Console
    match /dev/dev/admin/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /prod/prod/admin/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Cursos — lectura pública; escritura solo Admin SDK
    match /dev/dev/courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }
    match /prod/prod/courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // Eventos — lectura pública; escritura solo Admin SDK
    match /dev/dev/events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /prod/prod/events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    // Empresarial (raíz)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }
    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if false;
    }

    // Catch-all lectura auth para colecciones legacy con prefijo dev_/prod_
    match /{collection}/{document=**} {
      allow read: if request.auth != null
        && (collection.matches('dev_.*') || collection.matches('prod_.*'));
      allow write: if false;
    }
  }
}
